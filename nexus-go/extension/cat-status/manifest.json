{
  "manifest_version": 3,
  "name": "Cat Status — Sakura Tool",
  "version": "2.5.0",
  "description": "Báo Discord khi Sakura Tool đang mở (kiểu PreMiD). Popup hiện 3 bước + tự chẩn đoán beacon.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Bật/tắt status"
    }
  }
}