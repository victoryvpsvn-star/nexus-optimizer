{
  "manifest_version": 3,
  "name": "Cat Status",
  "version": "2.2.0",
  "description": "Discord status kiểu PreMiD: chỉ hiện khi đang nghe nhạc (YouTube /watch, YouTube Music, Spotify...)",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://open.spotify.com/*",
    "https://soundcloud.com/*",
    "https://zingmp3.vn/*",
    "https://www.nhaccuatui.com/*",
    "https://music.apple.com/*",
    "https://www.deezer.com/*",
    "https://listen.tidal.com/*",
    "https://*.bandcamp.com/*",
    "https://music.amazon.com/*"
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Bật/tắt status"
    }
  }
}