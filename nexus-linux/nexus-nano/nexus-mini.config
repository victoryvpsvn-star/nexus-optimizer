# NEXUS NANO kernel — allnoconfig + bật list (bzImage ~4-7MB, KHÔNG modules, KHÔNG initramfs)
# Mục tiêu: boot UEFI Hyper-V Gen2 + qemu virtio, ext4, nftables SSH throttle, zram swap, serial console
CONFIG_64BIT=y
CONFIG_LOCALVERSION="-nexus1"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="nexus"
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_SYSVIPC=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- platform ---
CONFIG_ACPI=y
CONFIG_PCI_MSI=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ=y
CONFIG_PCI=y
CONFIG_DMI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_UTILS=y

# --- storage ---
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_SD=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# --- filesystem ---
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y

# --- network + nftables SSH throttle ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NF_CONNTRACK=y

# --- zram swap ---
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ZSTD=y

# --- console + misc ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PROC_SYSCTL=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_FHANDLE=y

# --- EFI ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# --- initramfs (ISO live v2) + CD/DVD mount sau boot + partition tables ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# --- dáng hình: siêu nhỏ, không modules — VHDX không truyền initrd (boot như cũ), ISO v2 dùng initramfs ---
CONFIG_MODULES=n
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
CONFIG_MAGIC_SYSRQ=n
