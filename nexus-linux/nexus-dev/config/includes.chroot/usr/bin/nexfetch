#!/bin/bash
# NEXUS nexfetch — info hệ thống + logo NEXUS (thuần bash, không phụ thuộc gói ngoài)
G='\033[1;36m'; P='\033[1;35m'; R='\033[0m'
os=$(sed -n 's/^PRETTY_NAME="\(.*\)"$/\1/p' /etc/os-release 2>/dev/null || echo NEXUS)
k=$(uname -r); a=$(uname -m)
up=$(cut -d. -f1 /proc/uptime | awk '{d=int($1/86400);h=int($1%86400/3600);m=int($1%3600/60); if(d)printf "%dd %dh",d,h; else if(h)printf "%dh %dm",h,m; else printf "%dm",m}')
pk=$(dpkg-query -W -f='\n' 2>/dev/null | wc -l)
mem=$(free -m 2>/dev/null | awk '/^Mem:/{printf "%d/%d MB",$3,$2}')
cpu=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //')
vm='bare-metal'; grep -qsi 'hypervisor' /proc/cpuinfo && vm='Hyper-V guest'
sh=$(ps -p $$ -o comm= 2>/dev/null || echo bash)
printf "%b\n" \
" $G    /\\      $R $P${os}$R" \
" $G   /  \\     $R Kernel : $k ($a)" \
" $G  /|/|\\    $R Uptime : $up" \
" $G  |__|      $R Shell  : $sh" \
" $G   ||       $R CPU    : $cpu" \
" $G   ||       $R RAM    : $mem" \
" $G NEXUS      $R Gói    : $pk" \
" $G  /\\       $R Runtime: $vm" \
" $G NEXUS Linux $R Cài gói: nx install <tên gói>$R"
