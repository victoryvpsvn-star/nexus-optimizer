#!/bin/bash
# NEXUS nx — trình quản lý gói của NEXUS Linux Dev (thay apt, backend apt-get)
S=""
[ "$(id -u)" -ne 0 ] && S="sudo"
# ISO slim không đóng gói apt lists — tự update lần đầu
ensure_lists() {
  if ! ls /var/lib/apt/lists/*Packages* >/dev/null 2>&1; then
    echo "[nx] apt lists trống (ISO slim) — chạy apt-get update lần đầu..."
    $S apt-get update
  fi
}
case "$1" in
  install|i) shift; ensure_lists; exec $S apt-get install -y "$@" ;;
  remove|r) shift; exec $S apt-get remove -y "$@" ;;
  purge) shift; exec $S apt-get purge -y "$@" ;;
  update) exec $S apt-get update ;;
  upgrade) shift; ensure_lists; exec $S apt-get upgrade -y "$@" ;;
  full-upgrade) shift; ensure_lists; exec $S apt-get full-upgrade -y "$@" ;;
  search|s) shift; ensure_lists; exec apt-cache search "$@" ;;
  info|show) shift; ensure_lists; exec apt-cache show "$@" ;;
  list) dpkg-query -W -f='${binary:Package}\t${Version}\n' 2>/dev/null ;;
  clean) exec $S apt-get clean ;;
  autoremove) exec $S apt-get autoremove -y ;;
  tools) cat /usr/share/nexus/tools.txt ;;
  hogs) ps -eo pid,user,pmem,pcpu,comm --sort=-pmem | head -11 ;;
  *) cat <<'EOF'
NEXUS nx 1.2 — trình quản lý gói DUY NHẤT của NEXUS (apt chỉ là engine nội bộ — giao diện là nx):
  nx install <gói>    cài gói (tự update lần đầu nếu lists trống)
  nx remove <gói>     gỡ gói
  nx purge <gói>      gỡ + xóa config
  nx update           cập nhật index
  nx upgrade          nâng cấp toàn bộ
  nx search <từ>      tìm gói
  nx info <gói>       thông tin gói
  nx list             liệt kê gói đã cài
  nx tools            bảng tra cứu tool dev/security đã cài sẵn
  nx clean|autoremove dọn rác hệ thống
  nx hogs             top 10 process ăn RAM/CPU nhiều nhất

Phục hồi tool đã cắt trong 1 phút:
  nx install build-essential gdb    (compiler + debugger)
  nx install nodejs npm             (Node.js dev)
  nx install gnupg aria2 neovim     (tiện ích đã slim)
EOF
 ;;
esac
