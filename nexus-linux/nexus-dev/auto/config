#!/bin/sh
# NEXUS Linux Dev — live-build config (Debian bookworm, terminal cho dev + tool kiểu Kali)
# Build: cd nexus-linux/nexus-dev && sudo sh ./auto/config && sudo lb build
set -e
lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --apt-recommends false \
    --squashfs-compression xz \
    --binary-images iso-hybrid \
    --debian-installer none \
    --iso-volume "NEXUS-Linux-Dev" \
    --bootappend-live "boot=live components quiet username=nexus password=nexus" \
    --mirror-bootstrap "http://deb.debian.org/debian" \
    --mirror-binary "http://deb.debian.org/debian" \
    "$@"
