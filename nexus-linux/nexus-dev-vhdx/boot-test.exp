#!/usr/bin/expect -f
# NEXUS VHDX boot smoke-test — qemu + OVMF UEFI: assert autologin + ssh/networking active + DHCP IP + port 22
set timeout 480
log_user 1
log_file /tmp/serial.log
spawn qemu-system-x86_64 -machine q35 -smp 2 -m 1024 -nographic -no-reboot -nic user,model=virtio-net-pci \
    -drive file=/tmp/test.raw,format=raw,if=virtio \
    -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd \
    -drive if=pflash,format=raw,file=/tmp/OVMF_VARS.fd
expect {
    -re "nexus@nexus" {}
    -re "login:" { send "nexus\r"; expect "Password:"; send "nexus\r" }
    -re "\(initramfs\)" {
        send "cat /proc/partitions; ls /dev/sd* 2>&1; ls /dev/vd* 2>&1\r"
        sleep 3
        puts "\nFAIL-DIAG: initramfs khong tim thay root device — xem /proc/partitions + /dev o tren"
        exit 1
    }
    timeout { puts "\nFAIL-NOLOGIN: khong thay login/autologin trong 480s — boot UEFI hoac systemd loi"; exit 1 }
    eof { puts "\nFAIL-EOF: qemu ket thuc som (kernel panic/reboot loop?)"; exit 1 }
}
sleep 5
# assert khong can D-Bus (systemctl tu session serial non-root bi 'Failed to connect to bus')
send "\rR=\$(pgrep -c sshd || true); echo SSHD=\$R\r"
expect {
    -re "SSHD=\[1-9\]" {}
    "SSHD=0" { puts "\nFAIL-SSHD: sshd khong chay"; exit 1 }
    timeout { puts "\nFAIL-SSHD: timeout"; exit 1 }
}
# doi IP toi da ~70s (nexus-net chay sau udev-settle + dhclient — TCG rat cham)
set ipcnt -1
for {set i 0} {$i < 7} {incr i} {
    send "R=\$(ip -4 -o addr show scope global | grep -c inet); echo IPCNT=\$R\r"
    expect {
        "IPCNT=1" { set ipcnt 1; break }
        -re "IPCNT=\[2-9\]" { set ipcnt 2; break }
        "IPCNT=0" { set ipcnt 0 }
        timeout { set ipcnt -1 }
    }
    sleep 10
}
if {$ipcnt < 1} {
    send "\rM=LINK; echo ==\$M==; ip -o link; M=RULES; echo ==\$M==; ls /etc/udev/rules.d/; M=DHC; echo ==\$M==; which dhclient; M=LOG; echo ==\$M==; sudo journalctl -b --no-pager 2>&1 | grep -iE 'networking|eth0|dhcp|nexus-net|renamed' | tail -14\r"
    expect {
        -re "nexus@nexus:~\$" {}
        timeout {}
    }
    puts "\nFAIL-IP: khong co IPv4 global sau 70s (DHCP/ifup loi) — xem DIAG o tren"
    exit 1
}
send "R=\$(ss -tln | grep -q ':22 ' && echo OK || echo BAD); echo PORT22=\$R\r"
expect {
    "PORT22=OK" {}
    "PORT22=BAD" { puts "\nFAIL-PORT22: sshd khong nghe port 22"; exit 1 }
    timeout { puts "\nFAIL-PORT22: timeout"; exit 1 }
}
# NPS E2E: nx install tree tu repo noi bo NEXUS + htop bake san qua NPS
send "R=\$(sudo nx install tree >/dev/null 2>&1 && echo INSTALLED-OK); echo NPSTREE=\$R\r"
expect {
    -re "NPSTREE=INSTALLED-OK" {}
    -re "NPSTREE=\s*$" { puts "\nFAIL-NPS: nx install tree that bai (repo noi bo/NPS loi)"; exit 1 }
    timeout { puts "\nFAIL-NPS: timeout"; exit 1 }
}
send "T=\$(tree --version | head -c6); echo TREEV=\$T\r"
expect {
    -re "TREEV=tree v" {}
    -re "TREEV=\s*$" { puts "\nFAIL-NPS: tree khong chay sau khi cai qua NPS"; exit 1 }
    timeout { puts "\nFAIL-NPS: timeout"; exit 1 }
}
send "H=\$(htop --version 2>/dev/null | head -1); echo NPSHTOP=\$H\r"
expect {
    -re "NPSHTOP=htop 3" {}
    -re "NPSHTOP=\s*$" { puts "\nFAIL-NPS: htop khong co (bake NPS loi)"; exit 1 }
    timeout { puts "\nFAIL-NPS: timeout"; exit 1 }
}
puts "\nBOOT TEST PASS: boot UEFI + autologin + sshd + DHCP IP + port 22 + NPS (kernel nexus + nx install tree + htop)"
send "sudo poweroff\r"
expect eof
exit 0
