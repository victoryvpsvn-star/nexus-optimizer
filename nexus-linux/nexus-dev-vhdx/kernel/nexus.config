# NEXUS kernel v1 — overrides trên x86_64 defconfig (kernel.org 6.1.100)
# Nguyên tắc: mọi driver boot-critical built-in (=y) — initramfs chỉ là bảo hiểm
# Ziel: Hyper-V Gen2/Gen1 + KVM/qemu virtio + ext4 + nftables + zram + BBR + serial console
CONFIG_LOCALVERSION="-nexus1"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="nexus"

# --- hypervisor guest (Hyper-V + KVM/qemu) ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_KEYBOARD=y

# --- virtio ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_SCSI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- storage ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# --- filesystem ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_LOOP=y

# --- network ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y

# --- nftables (SSH rate-limit kernel) ---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NF_CONNTRACK=y

# --- TCP BBR + fq ---
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y

# --- zram (swap nén zstd) ---
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ZSTD=y

# --- cgroup/namespaces (systemd yêu cầu) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_KCMP=y
CONFIG_INOTIFY_USER=y

# --- console ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=n
CONFIG_MAGIC_SYSRQ=y

# --- EFI ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_VARS=y

# --- dáng hình kernel: server responsive, không bloat ---
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_MODULE_SIG=n
# keyring: khong can (khong module sig) — bo luon de khong can libssl
CONFIG_SYSTEM_TRUSTED_KEYRING=n
CONFIG_SYSTEM_BLACKLIST_KEYRING=n
CONFIG_DEBUG_INFO=n
